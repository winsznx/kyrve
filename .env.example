# Kyrve Phase 1 environment. Copy to `.env` and fill in. `.env` is git-ignored.
#
# NEVER commit a filled copy of this file. No key in this file may hold more value than a
# testnet deployment costs. A key placed in a Cloudflare Worker secret is a HOT WALLET:
# anyone with deploy rights can exfiltrate it. See .claude/rules/security.md.

# ---------------------------------------------------------------------------------------------
# Chain access (read-only verification works with these alone)
# ---------------------------------------------------------------------------------------------

# Used by verify:osaka, verify:deployment, verify:markets and the indexer.
# Provider choice is load-bearing for eth_getLogs, not a free variable:
#   ethereum-sepolia-rpc.publicnode.com  rejects eth_getLogs as an archive request
#   1rpc.io/sepolia                      caps ranges at 50 blocks
#   sepolia.drpc.org                     serves 200-block ranges  <- pinned default
# See docs/day0/THREAT-MODEL.md T-9.
SEPOLIA_RPC_URL=https://sepolia.drpc.org

# Maximum block span per eth_getLogs call. Must not exceed what the pinned provider serves.
SEPOLIA_LOG_RANGE=200

# ---------------------------------------------------------------------------------------------
# Deployment (write access — only needed to broadcast)
# ---------------------------------------------------------------------------------------------

# Explicit opt-in. Every broadcast path refuses to run unless this is exactly "true".
DEPLOY_SEPOLIA=false

# Testnet deployer private key. Testnet-only, low balance, never reused elsewhere.
# scripts/deploy/sepolia.ts refuses to write this value to disk or to any manifest.
DEPLOYER_PRIVATE_KEY=

# Contract source verification.
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------------------------
# Nox
# ---------------------------------------------------------------------------------------------

# Handle gateway. The local stack publishes this on a Docker-assigned port; the Hardhat plugin
# prints it. There is no Nox mainnet.
NOX_GATEWAY_URL=

# Ethereum Sepolia NoxCompute proxy (verified live 2026-07-28, source-lock.json).
NOX_COMPUTE_ADDRESS=0x24Ef36Ec5b626D7DCD09a98F3083c2758F0F77bF

# ---------------------------------------------------------------------------------------------
# Cloudflare (deployment only; dry-run and local tests need none of these)
# ---------------------------------------------------------------------------------------------

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
