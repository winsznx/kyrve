{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kyrve",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  /*
   * The built web product, served by the Worker.
   *
   * `not_found_handling: "single-page-application"` is what makes a TYPED route work. Kyrve's router
   * is client-side, so `/proof/series/0x…` entered in the address bar must reach `index.html` — and
   * the failure without it is a 404 that is invisible from inside the app, because clicking never
   * exercises the server.
   *
   * `run_worker_first` for `/rpc` only: everything else is served straight from the asset store
   * without waking the Worker, so the site costs nothing to serve.
   */
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc"]
  },

  "vars": {
    "KYRVE_ENVIRONMENT": "sepolia"
  }

  // KYRVE_RPC_URL is deliberately absent from vars. The provider key lives in its path, so it is a
  // secret: `wrangler secret put KYRVE_RPC_URL`. It must never appear in this file or in an asset.
}
