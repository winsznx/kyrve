{
  "name": "kyrve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Confidential fixed-income liquidity network. One quote. The curve stays private.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:deps": "pnpm audit --audit-level moderate",
    "brand:build": "python3 scripts/brand/build-assets.py",
    "brand:verify": "python3 scripts/brand/verify-assets.py",
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist workers/*/dist",
    "deploy:confidential": "tsx scripts/deploy/confidential.ts",
    "deploy:curve": "tsx scripts/deploy/curve.ts",
    "deploy:local": "tsx scripts/deploy/local.ts",
    "deploy:sepolia": "tsx scripts/deploy/sepolia.ts",
    "format": "biome check --write . && forge fmt",
    "generate": "tsx scripts/generate/abis.ts && tsx scripts/generate/deployments.ts && tsx scripts/generate/webmanifest.ts",
    "grids:build": "tsx scripts/generate/rate-grids.ts",
    "lint": "pnpm lint:ts && pnpm lint:sol && pnpm lint:imports",
    "lint:imports": "tsx scripts/verify/import-boundary.ts",
    "lint:sol": "forge fmt --check",
    "lint:ts": "biome check .",
    "preflight:sepolia": "tsx scripts/deploy/preflight.ts",
    "test": "pnpm test:contracts && pnpm test:unit && pnpm test:workers",
    "test:confidential": "pnpm --filter @kyrve/confidential test",
    "test:contracts": "forge test -vv",
    "test:markets": "tsx scripts/verify/markets.ts",
    "test:midnight": "forge test --match-path 'contracts/integration/test/*' -vv",
    "test:nox": "pnpm --dir spikes/nox exec hardhat test",
    "test:sepolia": "tsx scripts/test/sepolia-integration.ts",
    "test:sepolia-nox": "tsx scripts/test/sepolia-nox-smoke.ts",
    "test:unit": "vitest run",
    "test:workers": "pnpm --filter './workers/*' test",
    "typecheck": "tsc --build --force",
    "verify:bundles": "tsx scripts/verify/bundles.ts",
    "verify:confidential": "tsx scripts/verify/confidential.ts",
    "verify:contract-size": "tsx scripts/verify/contract-size.ts",
    "verify:curve": "tsx scripts/verify/curve.ts",
    "verify:deployed-bytecode": "tsx scripts/verify/deployed-bytecode.ts",
    "verify:deployment": "tsx scripts/verify/deployment.ts",
    "verify:etherscan": "tsx scripts/verify/etherscan.ts",
    "verify:etherscan:confidential": "tsx scripts/verify/etherscan-confidential.ts",
    "verify:etherscan:curve": "tsx scripts/verify/etherscan-curve.ts",
    "verify:generated": "tsx scripts/verify/generated.ts",
    "verify:licence": "tsx scripts/verify/licence.ts",
    "verify:local": "tsx scripts/verify/deployment.ts local",
    "verify:markets": "tsx scripts/verify/markets.ts",
    "verify:midnight-bytecode": "tsx scripts/verify/midnight-bytecode.ts",
    "verify:nox-runtime": "tsx scripts/verify/nox-runtime.ts",
    "verify:nox-stack": "tsx scripts/verify/nox-stack.ts",
    "verify:osaka": "tsx scripts/verify/osaka.ts",
    "verify:phase1": "tsx scripts/phase1/gate.ts",
    "verify:phase2": "tsx scripts/phase2/gate.ts",
    "verify:privacy-scan": "tsx scripts/verify/privacy-scan.ts",
    "verify:secrets": "tsx scripts/verify/secrets.ts",
    "verify:security": "pnpm verify:secrets && pnpm verify:licence && pnpm verify:slither && pnpm audit:deps && pnpm lint:imports && pnpm verify:bundles",
    "verify:sepolia": "tsx scripts/verify/deployment.ts sepolia",
    "verify:slither": "tsx scripts/verify/slither.ts",
    "verify:source-lock": "tsx scripts/verify/source-lock.ts",
    "verify:toolchain": "tsx scripts/verify/toolchain.ts",
    "verify:vendor": "tsx scripts/verify/vendor.ts",
    "web:dev": "pnpm --filter @kyrve/web dev",
    "wrangler:dry-run": "pnpm --filter './workers/*' dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@kyrve/config": "workspace:*",
    "@kyrve/curve": "workspace:*",
    "@kyrve/nox": "workspace:*",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "viem": "2.55.10",
    "vitest": "4.1.0"
  }
}
